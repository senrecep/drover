{
  "global": {
    "alt-shift-e": "drover-arrange.equalize",
    "alt-shift-a": "drover-arrange.open",
    "alt-shift-s": "drover-arrange.save",
    "alt-shift-g": "drover-arrange.grid",
    "cmd-k": "mod.open:drover-goto",
    "alt-shift-i": "mod.open:drover-dispatch",
    "cmd-shift-k": "mod.open:drover-composer",
    "cmd-shift-o": "mod.open:drover-projects",
    "cmd-alt-o": "mod.open:drover-open",
    "cmd-alt-e": "drover-tabs.open-in",
    "cmd-shift-g": "mod.open:drover-git",
    "cmd-shift-j": "drover-tabs.panels"
  },
  "layout:drover": {
    "cmd-shift-b": "layout.toggle:panel",
    "cmd-shift-v": {
      "command": "layout.select",
      "args": {
        "stack": "panel-body",
        "child": "drover-review"
      }
    },
    "cmd-shift-e": {
      "command": "layout.select",
      "args": {
        "stack": "panel-body",
        "child": "drover-files"
      }
    },
    "cmd-alt-y": {
      "command": "layout.select",
      "args": {
        "stack": "panel-body",
        "child": "drover-history"
      }
    },
    "cmd-alt-s": {
      "command": "layout.select",
      "args": {
        "stack": "panel-body",
        "child": "drover-sim"
      }
    }
  },
  "mod:drover-inbox": {
    "cmd-w": "overlay.close",
    "ctrl-alt-shift-x": "overlay.close",
    "cmd-shift-w": "overlay.close",
    "ctrl-alt-x": "overlay.close"
  },
  "mod:drover-agent-tree": {
    "cmd-w": "overlay.close",
    "ctrl-alt-shift-x": "overlay.close",
    "cmd-shift-w": "overlay.close",
    "ctrl-alt-x": "overlay.close"
  },
  "mod:drover-pane": {
    "cmd-w": "overlay.close",
    "ctrl-alt-shift-x": "overlay.close",
    "cmd-shift-w": "overlay.close",
    "ctrl-alt-x": "overlay.close"
  },
  "mod:drover-actions": {
    "cmd-w": "overlay.close",
    "ctrl-alt-shift-x": "overlay.close",
    "cmd-shift-w": "overlay.close",
    "ctrl-alt-x": "overlay.close"
  },
  "mod:drover-files": {
    "cmd-alt-f": "drover-files.focus-filter",
    "cmd-shift-.": "drover-files.toggle-hidden",
    "cmd-alt-p": "drover-files.toggle-follow",
    "cmd-r": "drover-files.refresh"
  },
  "mod:drover-viewer": {
    "cmd-s": "drover-viewer.save",
    "cmd-e": "drover-viewer.toggle",
    "cmd-r": "drover-viewer.reload",
    "ctrl--": "drover-viewer.back",
    "cmd-alt-r": "drover-viewer.revert"
  },
  "mod:drover-open": {
    "cmd-alt-o": "drover-open.clipboard"
  }
}
